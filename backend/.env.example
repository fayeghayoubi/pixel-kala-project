# پورت سرور — طبق پروژه‌ی قبلی‌ات روی 4000 گذاشتیم
PORT=4000

# آدرس اتصال MongoDB (لوکال یا Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pixel-kala

# رمز امضای توکن JWT — در پروداکشن حتماً یک مقدار طولانی و تصادفی بگذارید
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# آدرس فرانت‌اند برای تنظیم CORS
CLIENT_URL=http://127.0.0.1:5500
